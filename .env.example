# ---- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard -> your project -> Connect -> "Transaction pooler" connection string.
# Use the pooler (port 6543) for the running app; it works from serverless/hosted environments.
# The password is the one you set when creating the project (Project Settings -> Database -> reset it if lost).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=10

# Public URL of the site (canonical URLs, sitemap, OAuth redirect)
SITE_URL=http://localhost:3000
# Where uploaded photos/videos/PDFs are stored (default ./data/uploads). Use a persistent volume in production.
# UPLOAD_DIR=/var/lib/10cent/uploads

# --- Needs your input ---------------------------------------------------
# SMS/WhatsApp provider key. While unset, OTPs are shown on screen (test mode)
# and all SMS/email/WhatsApp messages queue in the admin "Message outbox".
SMS_PROVIDER_KEY=
# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seller details printed on GST invoices
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_GSTIN=
# Secret for scheduled jobs: send as header x-cron-secret to /api/cron/<job>
CRON_SECRET=

# --- Dev / testing only -------------------------------------------------
# Allow login cookies over plain http when running `next start` locally
# INSECURE_COOKIES=1
# Allow CRM webhooks to private/localhost URLs in production
# ALLOW_PRIVATE_WEBHOOKS=1
